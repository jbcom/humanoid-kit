{
  "name": "humanoid-kit-hair",
  "version": "0.0.0",
  "description": "Hair for humanoid-kit: 16 scalp styles, 12 eyebrows, 4 eyelashes and 9 source-bound facial-hair attachments, packed from MakeHuman assets. Optional: install it only if your figures wear hair.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Jon Bogaty <jon@jonbogaty.com>",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./data/*": "./data/*",
    "./source/*": "./source/*",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "index.d.ts", "data", "source", "README.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbcom/humanoid-kit.git",
    "directory": "packs/hair"
  },
  "bugs": {
    "url": "https://github.com/jbcom/humanoid-kit/issues"
  },
  "homepage": "https://jbcom.github.io/humanoid-kit/",
  "engines": {
    "node": ">=24"
  },
  "keywords": ["humanoid-kit", "makehuman", "hair", "character"]
}
