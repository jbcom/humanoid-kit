{
  "name": "humanoid-kit",
  "version": "0.0.0",
  "description": "Universal parametric human and anthro figures for three.js and React Three Fiber: one CC0 base mesh, independent regional traits, subdivision, rigging, hair, clothing fit and a contextual tap-to-edit creator.",
  "type": "module",
  "license": "MIT",
  "author": "Jon Bogaty <jon@jonbogaty.com>",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "default": "./dist/editor/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "default": "./dist/worker/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ],
      "editor": [
        "./dist/editor/index.d.ts"
      ],
      "worker": [
        "./dist/worker/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "build:playground": "vite build --config playground/vite.config.ts --base /humanoid-kit/playground/",
    "clean": "node -e \"for (const d of ['dist', 'dist-playground', 'coverage']) require('node:fs').rmSync(d, { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:docs": "markdownlint-cli2 README.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md CHANGELOG.md NOTICE.md AGENTS.md \"docs/**/*.md\" \"!docs/node_modules/**\" \"!docs/dist/**\" .github/PULL_REQUEST_TEMPLATE.md",
    "package:check": "publint && attw --pack . --profile esm-only && node scripts/verify-package.mjs",
    "verify": "pnpm run lint && pnpm run lint:docs && pnpm run typecheck && pnpm run coverage && pnpm run build && pnpm run package:check",
    "pack:data": "node scripts/pack-makehuman.ts",
    "check:pages": "node scripts/check-pages-build.mjs",
    "prepack": "pnpm run build",
    "docs:dev": "pnpm --filter humanoid-kit-docs dev",
    "docs:build": "pnpm --filter humanoid-kit-docs build",
    "docs:check": "pnpm --filter humanoid-kit-docs check",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "@react-three/drei": ">=10",
    "@react-three/fiber": ">=9",
    "react": ">=19",
    "three": ">=0.180"
  },
  "peerDependenciesMeta": {
    "@react-three/drei": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.64.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "humanoid-kit-body": "workspace:*",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "postprocessing": "^6.39.5",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-git-hooks": "^2.14.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "markdownlint-cli2"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jbcom/humanoid-kit.git"
  },
  "bugs": {
    "url": "https://github.com/jbcom/humanoid-kit/issues"
  },
  "homepage": "https://jbcom.github.io/humanoid-kit/",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1",
  "keywords": [
    "three",
    "threejs",
    "react-three-fiber",
    "r3f",
    "humanoid",
    "character",
    "avatar",
    "procedural",
    "morph-targets",
    "subdivision",
    "rigging",
    "character-creator"
  ]
}
